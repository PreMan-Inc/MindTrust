# Copy outside the repository or to a gitignored .env; never commit real secrets.
DOMAIN=workspace.example.com
ACME_EMAIL=ops@example.com
# Generate a unique value with: openssl rand -hex 32
MINDTRUST_ADMIN_TOKEN=
WORKSPACE_SUBNET=172.30.10.0/28
PROXY_IP=172.30.10.2

# Optional existing corporate identity provider. Register this EXACT redirect URI.
MINDTRUST_OIDC_ISSUER=
MINDTRUST_OIDC_CLIENT_ID=
MINDTRUST_OIDC_CLIENT_SECRET=
# When enabled, use https://workspace.example.com/api/auth/oidc/callback
MINDTRUST_OIDC_REDIRECT_URI=
MINDTRUST_OIDC_LABEL=Company SSO

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

{
  "name": "mindtrust",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Agent observability and evaluations by PreMan",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "seed": "tsx server/seed.ts",
    "backup": "tsx scripts/backup.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "express": "5.3.0",
    "lucide-react": "1.55.0",
    "openid-client": "6.8.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "braintrust": "3.37.2",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}

# Node.js 24+; copy to .env. Keep credentials out of Git.
PORT=4310
MINDTRUST_HOST=127.0.0.1
MINDTRUST_DB=./data/mindtrust.sqlite
MINDTRUST_SEED=true

# Required for any non-loopback binding. Generate: openssl rand -hex 32
MINDTRUST_ADMIN_TOKEN=
# Optional remote UI origins, comma-separated. Local ports are already allowed.
MINDTRUST_ALLOWED_ORIGINS=
# Externally reachable origin advertised to the Braintrust SDK (set for hosted deployments).
# Leave unset locally so the SDK uses the request origin.
# MINDTRUST_PUBLIC_URL=https://customer.example.com
# Production is enabled by MINDTRUST_MODE=production or NODE_ENV=production.
# Use deploy/compose.production.yaml for a TLS-terminated customer workspace.
MINDTRUST_MODE=development
# Exact proxy IP addresses only; never trust arbitrary forwarded headers.
MINDTRUST_TRUSTED_PROXIES=
# Optional OIDC single sign-on. Users must be explicitly provisioned for SSO.
MINDTRUST_OIDC_ISSUER=
MINDTRUST_OIDC_CLIENT_ID=
MINDTRUST_OIDC_CLIENT_SECRET=
MINDTRUST_OIDC_REDIRECT_URI=
MINDTRUST_OIDC_LABEL=Company SSO

# Optional: enables real model calls in Playground and evaluations.
# The server calls this configured endpoint; browser requests cannot override it.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

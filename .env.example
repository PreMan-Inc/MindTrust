# Node.js 24+; copy to .env. Keep credentials out of Git.
PORT=4310
MINDTRUST_HOST=127.0.0.1
MINDTRUST_DB=./data/mindtrust.sqlite
MINDTRUST_SEED=true

# Required for any non-loopback binding. Generate: openssl rand -hex 32
MINDTRUST_ADMIN_TOKEN=
# Optional remote UI origins, comma-separated. Local ports are already allowed.
MINDTRUST_ALLOWED_ORIGINS=

# Optional: enables real model calls in Playground and evaluations.
# The server calls this configured endpoint; browser requests cannot override it.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
